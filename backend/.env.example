# Copy to .env and adjust. Never commit .env.
PORT=3000
NODE_ENV=development

# Required. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# In production the server refuses to start with the placeholder or a secret shorter than 32 chars.
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# postgresql://<user>:<password>@<host>:<port>/<database>  (matches docker-compose.yml)
DATABASE_URL=postgresql://ilmgo:ilmgo@localhost:5432/ilmgo

# Comma-separated browser origins allowed to call the API. Unset = localhost only.
CORS_ORIGINS=http://localhost:5173

# Admin account created by `npm run migrate` (defaults: admin@ilmgo.uz / Admin123!, dev only).
ADMIN_EMAIL=admin@ilmgo.uz
ADMIN_PASSWORD=Admin123!

# Behind a reverse proxy set to the number of proxy hops (e.g. 1) so rate limits see real IPs.
# TRUST_PROXY=1
